# Google Gemini AI Studio API Configuration
GEMINI_API_KEY=your_google_ai_studio_key_here
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_REASONING_MODEL=gemini-3.8-flash

# On-Machine Local ML Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
WHISPER_MODEL_SIZE=small
HF_HOME=/app/.cache/huggingface

# Database & Cache Infrastructure
POSTGRES_USER=learner
POSTGRES_PASSWORD=learner_pass
POSTGRES_DB=adaptive_learning
DATABASE_URL=postgresql://learner:learner_pass@postgres:5432/adaptive_learning
REDIS_URL=redis://redis:6379/0
